# Product API origin (backend URL)
# Dev: http://localhost:8001
# Production (один домен): относительный путь — запросы на тот же хост, Nginx проксирует локально
# VITE_PRODUCT_API_ORIGIN=/catalog
VITE_PRODUCT_API_ORIGIN=http://localhost:8001

# Каталог (ссылка в навигации и API)
# Dev: http://localhost:8001
# Production: /catalog (тот же хост = grgroup.kz в интернете)
# VITE_CATALOG_URL=/catalog
VITE_CATALOG_URL=http://localhost:8001
