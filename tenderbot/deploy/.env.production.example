# Production environment variables для grgroup.kz
# Скопируйте соответствующие секции в .env файлы каждого компонента

# ============================================
# Root Site (.env в корне проекта)
# ============================================
VITE_CATALOG_URL=https://grgroup.kz/catalog
VITE_PRODUCT_API_ORIGIN=https://grgroup.kz/catalog

# ============================================
# TenderBot (tenderbot/.env)
# ============================================
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_id

# Database (PostgreSQL рекомендуется для production)
DATABASE_URL=postgresql+asyncpg://tenderbot:your_password@db:5432/tenderbot

# Веб-админка (ОБЯЗАТЕЛЬНО смените!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_password_here
WEB_SECRET_KEY=your_secret_key_here  # openssl rand -hex 32

# Домен для Mini App
MINIAPP_BASE_URL=https://grgroup.kz
WEB_PORT=8000
WEB_HOST=0.0.0.0

# ============================================
# APISite (tenderbot/apisite/.env)
# ============================================
PORT=8001
HOST=0.0.0.0
UVICORN_WORKERS=2

# CORS настройки (для production ограничить до конкретного домена)
CORS_ORIGINS=https://grgroup.kz

# API ключи (если нужны)
API_KEY=your_api_key_here
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_google_cse_id

# Парсер изображений
IMAGE_PARSER_ENABLED=true
IMAGE_PARSER_MAX_PAGES=0
IMAGE_PARSER_STARTUP_DELAY=30

# LLM API (опционально)
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini
# или
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openai/gpt-4o-mini

# ============================================
# APISite React (tenderbot/apisite/react/.env)
# ============================================
VITE_BASE_PATH=/catalog
VITE_MAIN_SITE_URL=https://grgroup.kz
VITE_BOT_URL=https://t.me/tenderlbot
# VITE_API_ORIGIN можно оставить пустым для относительных путей
