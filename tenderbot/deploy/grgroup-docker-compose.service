# Автозапуск Docker Compose (TenderBot + APISite) при загрузке сервера
# Установка:
#   sudo cp /opt/tenderAppSite-main/tenderbot/deploy/grgroup-docker-compose.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable grgroup-docker-compose
#
# После перезагрузки сервера контейнеры поднимутся автоматически.

[Unit]
Description=Grgroup Docker Compose (TenderBot, APISite)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/tenderAppSite-main/tenderbot
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
