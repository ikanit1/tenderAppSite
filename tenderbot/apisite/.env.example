# Настройки сервера
# PORT=8001
# HOST=0.0.0.0
# UVICORN_WORKERS=2

# CORS настройки (при allow_credentials нужен явный список origin, не *)
# Для production: CORS_ORIGINS=https://grgroup.kz
# Для dev (синхронизация корзины 5173 и 8001): оба origin через запятую
CORS_ORIGINS=http://localhost:5173,http://localhost:8001

# LLM API: приоритет у OpenAI, если задан OPENAI_API_KEY
# Подставьте свой ключ вручную в .env

# OpenAI (api.openai.com)
OPENAI_API_KEY=

# Модель OpenAI (по умолчанию gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# OpenRouter (если OPENAI_API_KEY не задан)
OPENROUTER_API_KEY=

# OPENROUTER_MODEL=openai/gpt-4o-mini

# Отправка заказов на email при оформлении (checkout)
# Адрес, на который приходят заказы
ADMIN_EMAIL=
# SMTP (например Gmail, Yandex): хост, порт, логин, пароль приложения
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
