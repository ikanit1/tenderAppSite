# Настройки сервера
# PORT=8001
# HOST=0.0.0.0
# UVICORN_WORKERS=2

# CORS настройки
# Для production: CORS_ORIGINS=https://grgroup.kz
# Для dev: CORS_ORIGINS=* (или оставить пустым)
# CORS_ORIGINS=*

# LLM API: приоритет у OpenAI, если задан OPENAI_API_KEY
# Подставьте свой ключ вручную в .env

# OpenAI (api.openai.com)
OPENAI_API_KEY=

# Модель OpenAI (по умолчанию gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# OpenRouter (если OPENAI_API_KEY не задан)
OPENROUTER_API_KEY=

# OPENROUTER_MODEL=openai/gpt-4o-mini
