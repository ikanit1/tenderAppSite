# Базовый путь для роутера и статических ресурсов
# Dev: не задавать (пусто) - работает напрямую на порту 3000
# Production: /catalog - для работы под префиксом /catalog/
# VITE_BASE_PATH=/catalog

# Базовый URL бэкенда (FastAPI)
# Dev: прокси Vite -> 8001, можно не задавать
# Production (под /catalog/): оставить пустым для относительных путей или указать https://grgroup.kz/catalog
# VITE_API_ORIGIN=http://localhost:8001

# Ссылка на Telegram-бота для кнопок в интерфейсе каталога.
VITE_BOT_URL=https://t.me/tenderlbot

# Ссылка на основной сайт (кнопка «Главный сайт» в шапке каталога)
# Dev: http://localhost:5173
# Production: https://grgroup.kz
VITE_MAIN_SITE_URL=http://localhost:5173
